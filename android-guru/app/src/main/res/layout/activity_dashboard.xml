<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard Guru"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/userEmailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="UJIANKU V1.0-A • Dashboard Guru"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu Guru"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/menuBankSoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="BANK SOAL" />

                <Button
                    android:id="@+id/menuBuatUjian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BUAT UJIAN" />

                <Button
                    android:id="@+id/menuDataSiswa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DATA SISWA" />

                <Button
                    android:id="@+id/menuNilai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NILAI" />

                <Button
                    android:id="@+id/menuDaftarUjian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DAFTAR UJIAN" />

                <Button
                    android:id="@+id/menuProfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROFIL GURU" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="LOGOUT" />

    </LinearLayout>
</ScrollView>
